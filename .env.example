PORT=8890
# 'development' locally only: selects the passwordless localhost Redis (no
# REDIS_* fields needed) and includes error details in 500 responses. Leave it
# unset on a host.
NODE_ENV=
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
# Any address on the Resend-verified domain; no mailbox needed.
SENDER_EMAIL=Heed <no-reply@reactmode.dev>
REPLYTO_EMAIL=support@reactmode.dev
# Preferred in every environment: one url carrying host, port, credentials and
# database. A rediss:// scheme enables TLS by itself. Takes precedence over all
# of the fields below. Locally, use a database index other than Elevra's.
REDIS_URL=redis://127.0.0.1:6379/1

# Fallback only.
REDIS_HOST=
REDIS_PORT=
REDIS_PASS=
REDIS_USERNAME=
REDIS_DB=
RESEND_API_KEY=
DATABASE_URL=postgresql://<user>:<password>@localhost:5433/heed?sslmode=disable

# AI providers, tried in order by src/lib/ai.ts: Groq first, OpenRouter as the
# fallback. Either one alone works; with neither set every AI call answers 503
# AI_UNAVAILABLE. Keep only providers that neither train on nor retain prompts.
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_ANDROID_CLIENT_ID=759055431608-ibdorhdou7jodgffh2oilou8komujbed.apps.googleusercontent.com

# Gmail connection (step 1). The Web application OAuth client, not the Android
# one. The redirect uri must match the Google console exactly; it points at the
# deployed server even locally, so the phone's browser can reach it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://heed-server.onrender.com/v1/mail-accounts/oauth/callback
APP_CALLBACK_URL=heed://oauth/callback
# 32 random bytes, base64. Encrypts stored Gmail tokens; changing it orphans
# every connected account. Use a different value per environment.
TOKEN_ENCRYPTION_KEY=
