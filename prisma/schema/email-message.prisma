enum EmailCategory {
  NEEDS_REPLY
  IMPORTANT
  ROUTINE
  NEWSLETTER
  PROMOTION
  UNSURE
}

enum EmailAction {
  MARKED_READ
  LEFT_UNREAD
  AWAITING_REPLY
  UNDONE
  PENDING_CONFIRM
  REPLIED
}

enum TriageSource {
  RULE
  HEADER
  AI
  FALLBACK
}

model EmailMessage {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  mailAccountId String
  mailAccount   MailAccount @relation(fields: [mailAccountId], references: [id], onDelete: Cascade)

  gmailMessageId String
  gmailThreadId  String
  fromName       String?
  fromEmail      String
  subject        String
  receivedAt     DateTime

  // Null until triaged; the sync's next pass picks up anything still null.
  category       EmailCategory?
  action         EmailAction?
  decidedBy      TriageSource?
  summary        String?
  reason         String?
  triageAttempts Int           @default(0)
  triagedAt      DateTime?

  // Set when a backlog run found it; live triage leaves these rows alone.
  backlogRunId String?
  backlogRun   BacklogRun? @relation(fields: [backlogRunId], references: [id], onDelete: SetNull)

  draft         ReplyDraft?
  // Automatic drafting gives up after three failures; drafting on demand ignores this.
  draftAttempts Int         @default(0)

  createdAt DateTime @default(now())

  @@unique([mailAccountId, gmailMessageId])
  @@index([userId, receivedAt])
  @@index([mailAccountId, category])
  @@index([backlogRunId, category])
}
