enum MailAccountStatus {
  ACTIVE
  NEEDS_REAUTH
}

model MailAccount {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  email           String
  googleSub       String
  refreshTokenEnc String
  status          MailAccountStatus @default(ACTIVE)

  handledLabelId String?
  replyLabelId   String?

  historyId    String?
  lastSyncedAt DateTime?

  // How the user writes from this address, learned from Sent and editable; every draft follows it.
  styleNote      String?
  styleLearnedAt DateTime?
  // What the user tells Heed about this inbox ("I'm a freelance designer; recruiters get a polite no").
  instruction    String?

  messages    EmailMessage[]
  backlogRuns BacklogRun[]
  senderRules SenderRule[]

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, email])
  @@index([email])
}
